# Public Supabase credentials only.
# Never put the service_role key here or anywhere in frontend code.
# Create a project at https://supabase.com, run supabase/schema.sql,
# then copy the Project URL and the anon public key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub project pages only, for example /bph-sales-assistant/
# Leave unset for local dev, Vercel, and username.github.io root sites.
# GITHUB_PAGES_BASE=/your-repository-name/
